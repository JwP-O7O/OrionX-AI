# OrionX-AI Environment Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR API KEYS

ORIONX_ENV=development
ORIONX_LOG_LEVEL=INFO
ORIONX_DEMO_MODE=false

# Google Cloud / Vertex AI Parameters
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1
API_KEY=your-gemini-api-key-placeholder

# Server Configuration
API_BACKEND_HOST=127.0.0.1
API_BACKEND_PORT=5000
API_PAYLOAD_MAX_SIZE=7mb

# Security & Circuit Breakers
MAX_MONTHLY_LLM_BUDGET_EUR=150.00
MAX_HOURLY_API_CALLS=100
MAX_AGENT_LOOP_ITERATIONS=5
